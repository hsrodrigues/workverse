# Servidor
PORT=3001
HOST=0.0.0.0
DATA_DIR=./data
# Origens permitidas no WebSocket (obrigatório em produção), separadas por vírgula
ALLOWED_ORIGINS=http://localhost:5173

# Midia (LiveKit). Em dev, sem estas variaveis, o servidor usa devkey/secret e ws://localhost:7880.
# Em producao defina as tres; chave e segredo devem ser os mesmos do livekit-server.
LIVEKIT_URL=ws://localhost:7880
PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Staff da plataforma (suporte/moderacao, cracha dourado). Lista de e-mails de contas JA cadastradas: email[:nivel],...
# nivel: helper | moderator | admin (padrao admin). Veja docs/staff.md. Tambem: npm run staff:grant -w @workverse/server -- email nivel
BOOTSTRAP_STAFF_EMAILS=

# ---- Producao (guia: docs/deploy.md; modelo completo: .env.production.example) ----
# NODE_ENV=production
# PUBLIC_URL=https://escritorio.seudominio.com
# DATABASE_URL=postgres://usuario:senha@host.neon.tech/neondb?sslmode=require
# MIGRATE_ON_BOOT=1
# REGISTRATION_MODE=closed        # closed (padrao: so a staff cria contas) | invite | open
# TRUST_PROXY=1
# METRICS_TOKEN=
# Midia em producao: LiveKit Cloud (wss://seu-projeto.livekit.cloud) nas 3 variaveis LIVEKIT_* acima.
# NUNCA use ALLOW_DEV_LOGIN em producao.
